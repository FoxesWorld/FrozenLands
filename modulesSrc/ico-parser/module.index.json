{
  "schema": "frozenlands.module.index.v1",
  "module": "ico-parser",
  "modulePath": "modulesSrc/ico-parser",
  "id": "engine.icoParser",
  "type": "runtime",
  "entrypoint": "org.takesome.frozenlands.engine.icons.IcoParserModule",
  "description": "Engine-owned ICO/app icon parser module: decodes ICO files, loads PNG/ICO app icons, selects window icon sizes, and exposes icon loader services.",
  "project": {
    "id": "takesome.frozenlands",
    "name": "Take Some() Frozen Lands",
    "projectModule": true,
    "moduleRole": "runtime",
    "moduleLayer": "runtime",
    "sourceRoot": "modulesSrc/ico-parser"
  },
  "lua": {
    "api": "src/main/resources/scripts/lua/api.lua",
    "events": "src/main/resources/scripts/lua/events.lua",
    "usage": "local ico = require('engine.icoParser'); ico.call('load', { reference = 'org/takesome/frozenlands/engine/ui/prelaunch/icon.png' })"
  },
  "runtime": {
    "configs": {},
    "assetRoots": [
      "src/main/resources"
    ]
  },
  "services": [
    "org.takesome.frozenlands.engine.icons.IcoFileParser",
    "org.takesome.frozenlands.engine.icons.EngineIconLoader",
    "engine.icons.loader"
  ]
}
